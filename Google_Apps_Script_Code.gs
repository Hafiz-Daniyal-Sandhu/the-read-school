const SCHOOL_EMAIL='ThereadschoolDharowal@gmail.com';const SHEET_NAME='Online Admissions';
function setup(){const props=PropertiesService.getScriptProperties();let id=props.getProperty('ADMISSIONS_SHEET_ID');let ss;if(id){ss=SpreadsheetApp.openById(id)}else{ss=SpreadsheetApp.create('The Read School - Online Admissions');id=ss.getId();props.setProperty('ADMISSIONS_SHEET_ID',id)}let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0){sh.appendRow(['Submitted At','Student Name','Date of Birth','Guardian Name','Parent Phone','Applying For','Previous School','Home Address','Additional Information']);sh.setFrozenRows(1)}Logger.log('Admissions sheet: '+ss.getUrl())}
function doPost(e){const p=e&&e.parameter?e.parameter:{};const required=['studentName','dateOfBirth','guardianName','parentPhone','classApplying','homeAddress'];if(required.some(k=>!String(p[k]||'').trim()))return response('Please complete all required fields.');const id=PropertiesService.getScriptProperties().getProperty('ADMISSIONS_SHEET_ID');if(!id)return response('The admission system is not configured yet.');const ss=SpreadsheetApp.openById(id);const sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);sh.appendRow([new Date(),p.studentName,p.dateOfBirth,p.guardianName,p.parentPhone,p.classApplying,p.previousSchool||'',p.homeAddress,p.additionalInfo||'']);const body='New online admission enquiry\\n\\nStudent: '+p.studentName+'\\nDate of birth: '+p.dateOfBirth+'\\nParent/Guardian: '+p.guardianName+'\\nPhone: '+p.parentPhone+'\\nClass: '+p.classApplying+'\\nPrevious school: '+(p.previousSchool||'Not provided')+'\\nAddress: '+p.homeAddress+'\\nAdditional information: '+(p.additionalInfo||'Not provided');MailApp.sendEmail(SCHOOL_EMAIL,'New Admission Enquiry: '+p.studentName,body);return response('Thank you. Your enquiry has been submitted.')}
function response(m){return HtmlService.createHtmlOutput('<p style="font:16px Arial;padding:20px;color:#10233f">'+m.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))+'</p>')}
